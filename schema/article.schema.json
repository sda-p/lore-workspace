{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact source extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "snapshot_sha256",
    "language",
    "claims",
    "proposed_topics",
    "review_flags",
    "coverage_gaps"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^src-[a-f0-9]{12}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "language": {
      "enum": [
        "en",
        "es"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assertion",
          "speaker",
          "paragraph_ids",
          "primary_topic",
          "topics",
          "modality",
          "confidence",
          "qualifiers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src-[a-f0-9]{12}-c(0[1-9]|[1-9][0-9])$"
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "paragraph_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^p[0-9]{4}$"
            }
          },
          "primary_topic": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "modality": {
            "enum": [
              "asserted",
              "speculative",
              "reported"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "qualifiers": {
            "type": "string"
          }
        }
      },
      "minItems": 1,
      "maxItems": 10
    },
    "proposed_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
